---
interface Props {
  date: string;
  time: string;
  seat: string;
  location: string;
  guestName: string;
}

const { date, time, seat, location, guestName } = Astro.props;
---

<div class="ticket-container relative w-full max-w-md mx-auto transform hover:scale-105 transition-transform duration-300 rotate-1">
  <!-- Perforated Edge Left -->
  <div class="absolute left-0 top-0 bottom-0 w-4 bg-jury-dark z-10 radial-pattern"></div>
  
  <div class="bg-jury-paper text-jury-dark p-6 pl-8 rounded-sm shadow-2xl relative overflow-hidden border-2 border-[#d4c4a0]">
    <!-- Grunge overlay effect -->
    <div class="absolute inset-0 opacity-10 bg-noise pointer-events-none"></div>
    
    <!-- Stamp -->
    <div class="absolute top-4 right-4 w-24 h-24 border-4 border-jury-red rounded-full flex items-center justify-center transform -rotate-12 opacity-80 mix-blend-multiply">
      <span class="text-jury-red font-judicial font-bold text-xs uppercase text-center leading-tight">
        EVIDENCE<br>#8492<br>ADMITTED
      </span>
    </div>

    <div class="relative z-10">
      <h2 class="font-judicial font-black text-2xl mb-2 tracking-widest border-b-2 border-jury-dark pb-2 uppercase">
        Citación Oficial
      </h2>
      
      <div class="space-y-4 mt-4 font-detective text-sm sm:text-base">
        <div class="flex justify-between items-end border-b border-gray-400 border-dashed pb-1">
          <span class="font-bold text-gray-600 text-xs uppercase">Evento</span>
          <span class="font-bold text-lg">The Jury Experience</span>
        </div>
        
        <div class="flex justify-between items-end border-b border-gray-400 border-dashed pb-1">
          <span class="font-bold text-gray-600 text-xs uppercase">Jurado</span>
          <span>{guestName}</span>
        </div>

        <div class="flex justify-between items-end border-b border-gray-400 border-dashed pb-1">
          <span class="font-bold text-gray-600 text-xs uppercase">Fecha</span>
          <span>{date}</span>
        </div>

        <div class="flex justify-between items-end border-b border-gray-400 border-dashed pb-1">
          <span class="font-bold text-gray-600 text-xs uppercase">Hora</span>
          <span>{time}</span>
        </div>

        <div class="flex justify-between items-end border-b border-gray-400 border-dashed pb-1">
          <span class="font-bold text-gray-600 text-xs uppercase">Ubicación</span>
          <span class="text-right">{location}</span>
        </div>
      </div>
      
      <div class="mt-6 pt-4 border-t-2 border-jury-dark flex justify-between items-center">
        <div class="barcode font-libre text-3xl opacity-80">
           ||| || ||| | ||
        </div>
        <div class="text-xs font-detective uppercase tracking-wider text-jury-red font-bold">
          Presencia Obligatoria
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .radial-pattern {
    background-image: radial-gradient(circle, transparent 6px, #0a0a0a 6px);
    background-size: 100% 20px;
    background-position: -10px 0;
  }
  
  .font-libre {
    font-family: 'Libre Barcode 39 Text', cursive;
  }

  .bg-noise {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='1'/%3E%3C/svg%3E");
  }
</style>